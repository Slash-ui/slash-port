{
  "name": "slash-port",
  "version": "0.2.0",
  "description": "See what is listening on your ports, understand what it is, and kill it safely.",
  "keywords": [
    "port",
    "ports",
    "kill-port",
    "eaddrinuse",
    "lsof",
    "netstat",
    "tui",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Slash UI Pte Ltd",
  "homepage": "https://github.com/Slash-ui/slash-port#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slash-ui/slash-port.git"
  },
  "bugs": {
    "url": "https://github.com/Slash-ui/slash-port/issues"
  },
  "type": "module",
  "bin": {
    "slash-port": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
